# --- Local dev (file store, password auth) ---
PORT=4000
STORE=file                       # file | dynamo
AUTH_MODE=password               # password | cognito
DATA_DIR=./.data
# CHANGE THIS in any shared/prod environment — signs the session JWTs:
JWT_SECRET=dev-only-change-me
TOKEN_TTL_SECONDS=28800          # 8h
CORS_ORIGINS=*                   # comma-separated origins, or * for local dev
FILES_BASE=                      # empty → served by this API at /files; else absolute base

# --- AWS mode (Lambda + DynamoDB + S3), used by the SAM stack ---
# STORE=dynamo
# AWS_REGION=ap-south-1
# DDB_TABLE=gispl-portal
# S3_BUCKET=gispl-portal-docs
# --- Cognito (optional: swap password auth for hosted-UI SSO) ---
# AUTH_MODE=cognito
# COGNITO_REGION=ap-south-1
# COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
