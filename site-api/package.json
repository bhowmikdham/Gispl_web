{
  "name": "gispl-site-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GISPL public site API — proposal requests, newsletter double opt-in and job applications. Runs locally (file store) or on AWS Lambda (DynamoDB + SES + S3).",
  "engines": { "node": ">=18" },
  "scripts": {
    "start": "node src/http/local-server.js",
    "dev": "node --watch src/http/local-server.js",
    "test": "node --test"
  },
  "dependencies": {},
  "optionalDependencies": {
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-presigned-post": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.700.0"
  }
}
